      ["success.on-solid", "success.solid"], ["success.on-tint", "success.tint"],
      ["info.fg", "bg.canvas"], ["info.fg", "bg.surface"], ["info.fg", "bg.raised"],
      ["info.on-solid", "info.solid"], ["info.on-tint", "info.tint"],
      ["accent.fg", "bg.selected"], ["danger.fg", "bg.selected"], ["warning.fg", "bg.selected"],
      ["success.fg", "bg.selected"], ["info.fg", "bg.selected"], ["text.muted", "bg.selected"],
      ["accent.fg", "bg.hover"], ["danger.fg", "bg.hover"], ["success.fg", "bg.hover"], ["info.fg", "bg.hover"],
      ["text.secondary", "bg.sunken"], ["accent.fg", "bg.sunken"], ["text.muted", "accent.tint"],
