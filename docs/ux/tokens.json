    "sidebar": "232px",
    "drawer": "420px",
    "approvalWindow": "400px x 560px",
    "controlHeight.sm": "28px",
    "controlHeight.md": "34px",
    "controlHeight.lg": "44px",
    "targetMin": "24px"
