  "contrast": {
    "$description": "Pairs checked by docs/ux/check-contrast.mjs in both themes. kind text = 4.5:1, ui = 3:1 (WCAG 2.2 1.4.3 and 1.4.11).",
    "text": [
      ["text.primary", "bg.canvas"], ["text.primary", "bg.surface"], ["text.primary", "bg.raised"],
      ["text.primary", "bg.sunken"], ["text.primary", "bg.hover"], ["text.primary", "bg.selected"],
      ["text.secondary", "bg.canvas"], ["text.secondary", "bg.surface"], ["text.secondary", "bg.raised"],
      ["text.secondary", "bg.hover"], ["text.secondary", "bg.selected"],
      ["text.muted", "bg.canvas"], ["text.muted", "bg.surface"], ["text.muted", "bg.raised"], ["text.muted", "bg.sunken"],
