{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: every IPC command, the dialogs for choosing a place to write (save, folder), and the few core permissions the UI uses (listen to events, read the version, zoom its own webview for the UI scale setting). The approval window has no zoom permission: it stays at 100%. No shell, no file system plugin. Files to read are chosen with `file_pick_open` (AUD-11).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-vault-status",
    "allow-vault-list-operators",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-unlock-recovery",
    "allow-vault-lock",
    "allow-vault-panic",
    "allow-kdf-benchmark",
    "allow-passphrase-strength",
    "allow-passphrase-generate",
    "allow-phrase-change",
    "allow-recovery-rotate",
    "allow-operator-add",
    "allow-operator-remove",
    "allow-operator-set-role",
    "allow-workspace-list",
    "allow-workspace-put",
    "allow-workspace-delete",
    "allow-item-list",
    "allow-item-get",
    "allow-item-create",
    "allow-item-update",
    "allow-item-delete",
    "allow-item-reveal",
    "allow-item-versions",
    "allow-item-restore-version",
    "allow-item-totp-preview",
    "allow-clipboard-copy-secret",
    "allow-password-generate",
    "allow-ssh-key-generate",
    "allow-ssh-key-import",
    "allow-agent-list",
    "allow-agent-create",
    "allow-agent-update",
    "allow-agent-set-status",
    "allow-agent-key-create",
    "allow-agent-key-rotate",
    "allow-agent-key-revoke",
    "allow-agent-issue-client-cert",
    "allow-agent-snippets",
    "allow-grant-list",
    "allow-grant-put",
    "allow-grant-delete",
    "allow-policy-simulate",
    "allow-request-list-pending",
    "allow-request-approve",
    "allow-request-deny",
    "allow-lease-list",
    "allow-lease-revoke",
    "allow-lease-revoke-all",
    "allow-audit-query",
    "allow-audit-verify",
    "allow-audit-export",
    "allow-settings-get",
    "allow-settings-set",
    "allow-network-status",
    "allow-network-set-bind",
    "allow-tls-export-ca",
    "allow-tls-use-local-ca",
    "allow-tls-load-custom",
    "allow-backup-create",
    "allow-backup-restore",
    "allow-csv-preview",
    "allow-csv-import",
    "allow-csv-export",
    "allow-ui-activity",
    "allow-clipboard-copy-once",
    "allow-file-pick-open",
    "allow-vault-recover-stranded",
    "allow-rustdesk-status",
    "allow-rustdesk-connect",
    "allow-remote-status",
    "allow-remote-import-bundle",
    "allow-remote-activate",
    "allow-remote-disconnect",
    "allow-remote-forget"
  ]
}
