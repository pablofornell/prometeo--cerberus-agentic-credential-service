# Cerberus vault backup. It runs `cerberusd backup` once and stops. Started by cerberusd-backup.timer.
# Install steps: docs/guides/backup-and-restore.md ("Back up the headless daemon").
# The binary is expected at /usr/local/bin/cerberusd. The service user "cerberus" must exist.
# It is safe while cerberusd.service runs: the copy is one SQLite read transaction (VACUUM INTO), so the daemon keeps
# writing. It needs no passphrase. The file stays encrypted, like the vault.

[Unit]
Description=Cerberus vault backup (consistent copy of the vault, safe while the daemon runs)

[Service]
Type=oneshot
User=cerberus
Group=cerberus
# Writes /var/lib/cerberus/backups/cerberus-<vault id>-<UTC time>.cerberus-backup and keeps the newest 14.
ExecStart=/usr/local/bin/cerberusd --config /etc/cerberus/cerberusd.toml backup --out /var/lib/cerberus/backups --keep 14
TimeoutStartSec=10min
Nice=10
UMask=0077

# State: the same folder as cerberusd.service.
StateDirectory=cerberus
StateDirectoryMode=0700
ReadWritePaths=/var/lib/cerberus

# Hardening. As cerberusd.service, but with no network at all: the backup reads and writes files only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# Only the system calls of a normal service. @system-service has mlock (@memlock), which the key pages need.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
PrivateUsers=yes
IPAddressDeny=any

# No core dumps. mlock needs room for the key pages.
LimitCORE=0
LimitMEMLOCK=64M
