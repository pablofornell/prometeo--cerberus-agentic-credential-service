# Copy to /etc/cerberus/cerberusd.toml. The file must be mode 0600 and owned by the cerberus user.
# Every key is optional. Environment variables CERBERUSD_DATA_DIR, CERBERUSD_BIND, CERBERUSD_PORT,
# CERBERUSD_HOST_NAMES, CERBERUSD_REQUIRE_MTLS, CERBERUSD_IDLE_LOCK_SECONDS, CERBERUSD_ADMIN_ENABLED,
# CERBERUSD_ADMIN_SESSION_IDLE_SECONDS and CERBERUSD_ADMIN_SESSION_MAX_SECONDS override these values.

# Absolute path. Holds vault.cerberus, tls/ and the unlock socket.
data_dir = "/var/lib/cerberus"

# Addresses to listen on. Keep loopback unless agents on other machines need the daemon.
bind = ["127.0.0.1", "::1"]

# TCP port, 1 to 65535. The CLI status command checks this port.
port = 7373

# Extra names for the TLS certificate and the allowed Host header, for example "agents.example.lan".
# host_names = []

# Client certificates (mTLS) on every connection. Must be true when bind has a non-loopback address.
# require_mtls = false

# Lock after this many idle seconds: 0 is off (the default), or 60 to 86400.
# idle_lock_seconds = 0

# Hard limit: lock this many seconds after each unlock. 0 is off (the default), or 900 to 604800.
# An admin can change it later in the vault settings; a saved setting wins over this value.
# max_unlocked_seconds = 0

# The admin API for an enrolled desktop app (ADR-0034, docs/guides/cerberusd.md "Remote admin from the
# desktop"). On by default (DEC-SRV-3). On mounts /admin/v1 (every route needs the client certificate of an enrolled
# desktop, so with none enrolled nothing is reachable), asks for client certificates, reads admin-clients.json and turns
# on approvals for ask grants. Set enabled = false for a server with no admin surface and no approvals.
# It is also needed for the first-time setup: with no vault in data_dir the daemon waits for its first client to create
# the vault, and the client comes out of it with an admin bundle (docs/guides/cerberusd.md, section 2). With
# enabled = false and no vault the daemon starts, logs why, and waits with no setup code.
# [admin]
# enabled = true
# session_idle_seconds = 900    # 60 to 3600
# session_max_seconds = 43200   # 900 to 86400
